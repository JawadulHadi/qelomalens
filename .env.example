# GEMINI_API_KEY: Required for Gemini AI capability calls. Without it, every
# capability falls back to the deterministic rule-based engine (never hard-fails).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted. AI Studio auto-injects this with
# the Cloud Run service URL; on Vercel it's your deployment URL.
APP_URL="MY_APP_URL"

# PORT: Local dev server port (ignored on Vercel, which manages its own).
PORT=3000

# -----------------------------------------------------------------------------
# Tenancy & demo API key
# -----------------------------------------------------------------------------
# SINGLE_TENANT_MODE: When true, every request resolves to one workspace
# tenant regardless of X-API-Key. Set to false to require a valid tenant key.
SINGLE_TENANT_MODE=true
AI_ENABLED=true
DEFAULT_TENANT_ID="default-tenant-001"
DEFAULT_TENANT_KEY="sk_live_qelomalens_default"

# MAX_FILE_SIZE_MB: Multer's upload limit. Vercel Functions hard-cap request
# bodies at 4.5 MB regardless of this value (not configurable) — set this to
# 4 for a Vercel deployment, or keep 25 for local dev / a non-Vercel host.
MAX_FILE_SIZE_MB=25

# -----------------------------------------------------------------------------
# Supabase (backend persistence + auth) — see DEPLOYMENT.md for full setup.
# Server-side only. Never expose the service_role key to the browser.
# Without these set, the app degrades gracefully to an in-memory input store
# (fine for local dev, NOT safe for a multi-instance/serverless deployment).
# -----------------------------------------------------------------------------
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Client-side Supabase config (safe to expose — Vite inlines VITE_* at build
# time). The anon key is public by design; access control is enforced by
# Postgres Row Level Security, not by keeping this secret.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_ANON_KEY"
